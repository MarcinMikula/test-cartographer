{
  "$defs": {
    "AutomationImpact": {
      "enum": [
        "none_detected",
        "current_test_risk",
        "mapped_context_stale",
        "human_review_required"
      ],
      "title": "AutomationImpact",
      "type": "string"
    },
    "ChangeDisposition": {
      "enum": [
        "unchanged",
        "locator_drift",
        "missing",
        "ambiguous"
      ],
      "title": "ChangeDisposition",
      "type": "string"
    },
    "ElementRegressionObservation": {
      "additionalProperties": false,
      "properties": {
        "automation_impact": {
          "$ref": "#/$defs/AutomationImpact"
        },
        "covered_by_current_framework_test": {
          "title": "Covered By Current Framework Test",
          "type": "boolean"
        },
        "current_locator_strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocatorStrategy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "current_locator_value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Locator Value"
        },
        "disposition": {
          "$ref": "#/$defs/ChangeDisposition"
        },
        "element_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Element Id",
          "type": "string"
        },
        "expected_locator_strategy": {
          "$ref": "#/$defs/LocatorStrategy"
        },
        "expected_locator_value": {
          "minLength": 1,
          "title": "Expected Locator Value",
          "type": "string"
        },
        "expected_locator_visible_count": {
          "maximum": 50,
          "minimum": 0,
          "title": "Expected Locator Visible Count",
          "type": "integer"
        },
        "item_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Item Id",
          "type": "string"
        },
        "observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "observed_attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservedAttribute"
          },
          "title": "Observed Attributes",
          "type": "array"
        },
        "semantic_visible_count": {
          "maximum": 50,
          "minimum": 0,
          "title": "Semantic Visible Count",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "element_id",
        "disposition",
        "automation_impact",
        "covered_by_current_framework_test",
        "expected_locator_strategy",
        "expected_locator_value",
        "expected_locator_visible_count",
        "semantic_visible_count",
        "observation_sha256"
      ],
      "title": "ElementRegressionObservation",
      "type": "object"
    },
    "LocatorStrategy": {
      "description": "Supported locator candidate types in the first contract.",
      "enum": [
        "role",
        "label",
        "test_id",
        "placeholder",
        "text",
        "css",
        "xpath"
      ],
      "title": "LocatorStrategy",
      "type": "string"
    },
    "ObservedAttribute": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "data-testid",
            "id",
            "name",
            "type",
            "aria-label"
          ],
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "ObservedAttribute",
      "type": "object"
    },
    "ReportReviewDecision": {
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "title": "ReportReviewDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ambiguous_count": {
      "minimum": 0,
      "title": "Ambiguous Count",
      "type": "integer"
    },
    "application_bug_claimed": {
      "const": false,
      "default": false,
      "title": "Application Bug Claimed",
      "type": "boolean"
    },
    "automatic_patch_created": {
      "const": false,
      "default": false,
      "title": "Automatic Patch Created",
      "type": "boolean"
    },
    "context_automatically_modified": {
      "const": false,
      "default": false,
      "title": "Context Automatically Modified",
      "type": "boolean"
    },
    "current_test_risk_count": {
      "minimum": 0,
      "title": "Current Test Risk Count",
      "type": "integer"
    },
    "decision": {
      "$ref": "#/$defs/ReportReviewDecision"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "html_persisted": {
      "const": false,
      "default": false,
      "title": "Html Persisted",
      "type": "boolean"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Id",
      "type": "string"
    },
    "inventory_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Inventory Id",
      "type": "string"
    },
    "live_llm_used": {
      "const": false,
      "default": false,
      "title": "Live Llm Used",
      "type": "boolean"
    },
    "locator_drift_count": {
      "minimum": 0,
      "title": "Locator Drift Count",
      "type": "integer"
    },
    "mapped_context_stale_count": {
      "minimum": 0,
      "title": "Mapped Context Stale Count",
      "type": "integer"
    },
    "missing_count": {
      "minimum": 0,
      "title": "Missing Count",
      "type": "integer"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ElementRegressionObservation"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "raw_page_persisted": {
      "const": false,
      "default": false,
      "title": "Raw Page Persisted",
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "screenshot_persisted": {
      "const": false,
      "default": false,
      "title": "Screenshot Persisted",
      "type": "boolean"
    },
    "stable_count": {
      "minimum": 0,
      "title": "Stable Count",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "run_id",
    "inventory_id",
    "generated_at",
    "decision",
    "observations",
    "stable_count",
    "locator_drift_count",
    "missing_count",
    "ambiguous_count",
    "current_test_risk_count",
    "mapped_context_stale_count"
  ],
  "title": "FrontendChangeReport",
  "type": "object"
}
