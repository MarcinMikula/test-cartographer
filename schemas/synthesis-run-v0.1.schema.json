{
  "$defs": {
    "ActionKind": {
      "description": "Small UI-action vocabulary for one guided process.",
      "enum": [
        "navigate",
        "fill",
        "click",
        "select",
        "check",
        "uncheck",
        "read"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "AuthorizedAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "target_element_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Element Id"
        },
        "test_data_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Data Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AuthorizedAction",
      "type": "object"
    },
    "AuthorizedComponent": {
      "additionalProperties": false,
      "properties": {
        "element_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/AuthorizedValue"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AuthorizedComponent",
      "type": "object"
    },
    "AuthorizedElement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "owner_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Owner Id",
          "type": "string"
        },
        "primary_locator": {
          "$ref": "#/$defs/AuthorizedLocator"
        },
        "semantic_role": {
          "$ref": "#/$defs/AuthorizedValue"
        }
      },
      "required": [
        "id",
        "owner_id",
        "name",
        "semantic_role",
        "primary_locator"
      ],
      "title": "AuthorizedElement",
      "type": "object"
    },
    "AuthorizedEvidenceReference": {
      "additionalProperties": false,
      "description": "Minimized evidence reference; raw source content and source_ref are excluded.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/SensitivityLevel"
        },
        "source_type": {
          "$ref": "#/$defs/EvidenceSourceType"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_type",
        "summary",
        "sensitivity"
      ],
      "title": "AuthorizedEvidenceReference",
      "type": "object"
    },
    "AuthorizedLocator": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/LocatorStrategy"
        },
        "value": {
          "$ref": "#/$defs/AuthorizedValue"
        }
      },
      "required": [
        "id",
        "strategy",
        "value"
      ],
      "title": "AuthorizedLocator",
      "type": "object"
    },
    "AuthorizedOutcome": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "related_element_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Related Element Ids",
          "type": "array"
        },
        "statement": {
          "$ref": "#/$defs/AuthorizedValue"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "AuthorizedOutcome",
      "type": "object"
    },
    "AuthorizedPage": {
      "additionalProperties": false,
      "properties": {
        "component_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Component Ids",
          "type": "array"
        },
        "element_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/AuthorizedValue"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AuthorizedPage",
      "type": "object"
    },
    "AuthorizedStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/AuthorizedAction"
        },
        "expected_state": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "page_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Page Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "order",
        "page_id",
        "intent",
        "action",
        "expected_state"
      ],
      "title": "AuthorizedStep",
      "type": "object"
    },
    "AuthorizedTestData": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "sensitivity": {
          "$ref": "#/$defs/SensitivityLevel"
        },
        "symbolic_ref": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Symbolic Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "symbolic_ref",
        "sensitivity"
      ],
      "title": "AuthorizedTestData",
      "type": "object"
    },
    "AuthorizedValue": {
      "additionalProperties": false,
      "description": "One authorized value copied into the bounded request.",
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "sensitivity": {
          "$ref": "#/$defs/SensitivityLevel"
        },
        "status": {
          "enum": [
            "confirmed",
            "observed"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "status",
        "evidence_ids",
        "sensitivity"
      ],
      "title": "AuthorizedValue",
      "type": "object"
    },
    "BoundedSynthesisRequest": {
      "additionalProperties": false,
      "description": "Provider-neutral, minimized request for one POM proposal.",
      "properties": {
        "application_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Application Id",
          "type": "string"
        },
        "application_name": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "components": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AuthorizedComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "context_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Context Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/AuthorizedElement"
          },
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/AuthorizedEvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "excluded_fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExcludedField"
          },
          "title": "Excluded Fields",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/AuthorizedOutcome"
          },
          "minItems": 1,
          "title": "Outcomes",
          "type": "array"
        },
        "output_schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Output Schema Version",
          "type": "string"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/AuthorizedPage"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "$ref": "#/$defs/AuthorizedValue"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "process_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Process Id",
          "type": "string"
        },
        "process_name": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "prohibited_claims": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Prohibited Claims",
          "type": "array"
        },
        "protocol_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Protocol Version",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "risk": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "role": {
          "$ref": "#/$defs/AuthorizedValue"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/AuthorizedStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "test_data": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AuthorizedTestData"
          },
          "title": "Test Data",
          "type": "array"
        }
      },
      "required": [
        "id",
        "context_id",
        "created_at",
        "application_id",
        "application_name",
        "environment",
        "process_id",
        "process_name",
        "purpose",
        "risk",
        "role",
        "preconditions",
        "steps",
        "outcomes",
        "pages",
        "elements",
        "evidence",
        "prohibited_claims"
      ],
      "title": "BoundedSynthesisRequest",
      "type": "object"
    },
    "EvidenceSourceType": {
      "description": "Origin of evidence retained by the local context model.",
      "enum": [
        "human",
        "document",
        "application",
        "repository",
        "execution",
        "system"
      ],
      "title": "EvidenceSourceType",
      "type": "string"
    },
    "ExcludedField": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ExclusionReason"
        }
      },
      "required": [
        "path",
        "reason",
        "explanation"
      ],
      "title": "ExcludedField",
      "type": "object"
    },
    "ExclusionReason": {
      "description": "Why a context field is deliberately excluded from the LLM request.",
      "enum": [
        "policy",
        "sensitivity",
        "status",
        "not_required"
      ],
      "title": "ExclusionReason",
      "type": "string"
    },
    "LocatorStrategy": {
      "description": "Supported locator candidate types in the first contract.",
      "enum": [
        "role",
        "label",
        "test_id",
        "placeholder",
        "text",
        "css",
        "xpath"
      ],
      "title": "LocatorStrategy",
      "type": "string"
    },
    "PomProposal": {
      "additionalProperties": false,
      "description": "Strict POM proposal returned by the LLM protocol.",
      "properties": {
        "claim_flags": {
          "$ref": "#/$defs/ProposalClaimFlags"
        },
        "components": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProposedComponentObject"
          },
          "title": "Components",
          "type": "array"
        },
        "context_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Context Id",
          "type": "string"
        },
        "fixtures": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProposedFixture"
          },
          "title": "Fixtures",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/ProposedMethod"
          },
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "open_questions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProposalQuestion"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/ProposedPageObject"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "request_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "test": {
          "$ref": "#/$defs/ProposedTest"
        }
      },
      "required": [
        "id",
        "request_id",
        "context_id",
        "summary",
        "pages",
        "methods",
        "test",
        "claim_flags"
      ],
      "title": "PomProposal",
      "type": "object"
    },
    "ProposalClaimFlags": {
      "additionalProperties": false,
      "properties": {
        "business_correctness": {
          "default": false,
          "title": "Business Correctness",
          "type": "boolean"
        },
        "execution_success": {
          "default": false,
          "title": "Execution Success",
          "type": "boolean"
        },
        "locator_stability": {
          "default": false,
          "title": "Locator Stability",
          "type": "boolean"
        },
        "repository_fit": {
          "default": false,
          "title": "Repository Fit",
          "type": "boolean"
        },
        "security_approval": {
          "default": false,
          "title": "Security Approval",
          "type": "boolean"
        }
      },
      "title": "ProposalClaimFlags",
      "type": "object"
    },
    "ProposalOwnerKind": {
      "description": "Logical automation object that owns a proposed method.",
      "enum": [
        "page",
        "component"
      ],
      "title": "ProposalOwnerKind",
      "type": "string"
    },
    "ProposalParseFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ProposalParseFailure",
      "type": "object"
    },
    "ProposalQuestion": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "related_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "ProposalQuestion",
      "type": "object"
    },
    "ProposalReviewDecision": {
      "description": "Human decision over one validated proposal.",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "title": "ProposalReviewDecision",
      "type": "string"
    },
    "ProposalValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/ValidationSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "title": "ProposalValidationIssue",
      "type": "object"
    },
    "ProposalValidationReport": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProposalValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "title": "ProposalValidationReport",
      "type": "object"
    },
    "ProposedAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "locator_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator Id"
        },
        "step_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Step Id",
          "type": "string"
        },
        "target_element_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Element Id"
        },
        "test_data_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Data Id"
        }
      },
      "required": [
        "step_id",
        "kind"
      ],
      "title": "ProposedAction",
      "type": "object"
    },
    "ProposedAssertion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "outcome_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "page_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Page Id",
          "type": "string"
        },
        "related_element_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Related Element Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "outcome_id",
        "page_id",
        "intent"
      ],
      "title": "ProposedAssertion",
      "type": "object"
    },
    "ProposedComponentObject": {
      "additionalProperties": false,
      "properties": {
        "class_name": {
          "pattern": "^[A-Z][A-Za-z0-9]{2,79}$",
          "title": "Class Name",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "method_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Method Ids",
          "type": "array"
        },
        "source_component_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Source Component Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "class_name",
        "source_component_id"
      ],
      "title": "ProposedComponentObject",
      "type": "object"
    },
    "ProposedFixture": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
