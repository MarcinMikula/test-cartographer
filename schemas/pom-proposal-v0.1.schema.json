{
  "$defs": {
    "ActionKind": {
      "description": "Small UI-action vocabulary for one guided process.",
      "enum": [
        "navigate",
        "fill",
        "click",
        "select",
        "check",
        "uncheck",
        "read"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "ProposalClaimFlags": {
      "additionalProperties": false,
      "properties": {
        "business_correctness": {
          "default": false,
          "title": "Business Correctness",
          "type": "boolean"
        },
        "execution_success": {
          "default": false,
          "title": "Execution Success",
          "type": "boolean"
        },
        "locator_stability": {
          "default": false,
          "title": "Locator Stability",
          "type": "boolean"
        },
        "repository_fit": {
          "default": false,
          "title": "Repository Fit",
          "type": "boolean"
        },
        "security_approval": {
          "default": false,
          "title": "Security Approval",
          "type": "boolean"
        }
      },
      "title": "ProposalClaimFlags",
      "type": "object"
    },
    "ProposalOwnerKind": {
      "description": "Logical automation object that owns a proposed method.",
      "enum": [
        "page",
        "component"
      ],
      "title": "ProposalOwnerKind",
      "type": "string"
    },
    "ProposalQuestion": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "related_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Related Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "ProposalQuestion",
      "type": "object"
    },
    "ProposedAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "locator_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator Id"
        },
        "step_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Step Id",
          "type": "string"
        },
        "target_element_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Element Id"
        },
        "test_data_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Data Id"
        }
      },
      "required": [
        "step_id",
        "kind"
      ],
      "title": "ProposedAction",
      "type": "object"
    },
    "ProposedAssertion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "outcome_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "page_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Page Id",
          "type": "string"
        },
        "related_element_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Related Element Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "outcome_id",
        "page_id",
        "intent"
      ],
      "title": "ProposedAssertion",
      "type": "object"
    },
    "ProposedComponentObject": {
      "additionalProperties": false,
      "properties": {
        "class_name": {
          "pattern": "^[A-Z][A-Za-z0-9]{2,79}$",
          "title": "Class Name",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "method_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Method Ids",
          "type": "array"
        },
        "source_component_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Source Component Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "class_name",
        "source_component_id"
      ],
      "title": "ProposedComponentObject",
      "type": "object"
    },
    "ProposedFixture": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{2,79}$",
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "secret_values_included": {
          "title": "Secret Values Included",
          "type": "boolean"
        },
        "uses_environment_from_context": {
          "title": "Uses Environment From Context",
          "type": "boolean"
        },
        "uses_role_from_context": {
          "title": "Uses Role From Context",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "uses_role_from_context",
        "uses_environment_from_context",
        "secret_values_included"
      ],
      "title": "ProposedFixture",
      "type": "object"
    },
    "ProposedMethod": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/ProposedAction"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{2,79}$",
          "title": "Name",
          "type": "string"
        },
        "owner_kind": {
          "$ref": "#/$defs/ProposalOwnerKind"
        },
        "owner_source_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Owner Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "owner_kind",
        "owner_source_id",
        "intent",
        "actions"
      ],
      "title": "ProposedMethod",
      "type": "object"
    },
    "ProposedPageObject": {
      "additionalProperties": false,
      "properties": {
        "class_name": {
          "pattern": "^[A-Z][A-Za-z0-9]{2,79}$",
          "title": "Class Name",
          "type": "string"
        },
        "component_object_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Component Object Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "method_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Method Ids",
          "type": "array"
        },
        "source_page_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Source Page Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "class_name",
        "source_page_id"
      ],
      "title": "ProposedPageObject",
      "type": "object"
    },
    "ProposedTest": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/ProposedAssertion"
          },
          "minItems": 1,
          "title": "Assertions",
          "type": "array"
        },
        "fixture_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Fixture Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "method_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Method Ids",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{2,79}$",
          "title": "Name",
          "type": "string"
        },
        "process_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Process Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "process_id",
        "method_ids",
        "assertions"
      ],
      "title": "ProposedTest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Strict POM proposal returned by the LLM protocol.",
  "properties": {
    "claim_flags": {
      "$ref": "#/$defs/ProposalClaimFlags"
    },
    "components": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposedComponentObject"
      },
      "title": "Components",
      "type": "array"
    },
    "context_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Context Id",
      "type": "string"
    },
    "fixtures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposedFixture"
      },
      "title": "Fixtures",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Id",
      "type": "string"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/ProposedMethod"
      },
      "minItems": 1,
      "title": "Methods",
      "type": "array"
    },
    "open_questions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposalQuestion"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/ProposedPageObject"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "request_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "test": {
      "$ref": "#/$defs/ProposedTest"
    }
  },
  "required": [
    "id",
    "request_id",
    "context_id",
    "summary",
    "pages",
    "methods",
    "test",
    "claim_flags"
  ],
  "title": "PomProposal",
  "type": "object"
}
