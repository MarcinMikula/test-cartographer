{
  "$defs": {
    "ValidationFindingKind": {
      "enum": [
        "failure",
        "friction",
        "unsupported_assumption",
        "safety_stop",
        "measurement_issue"
      ],
      "title": "ValidationFindingKind",
      "type": "string"
    },
    "ValidationLifecycleStage": {
      "enum": [
        "bootstrap",
        "intake",
        "browser_discovery",
        "context_review",
        "synthesis",
        "repository_mapping",
        "source_review",
        "delivery",
        "execution",
        "maintenance",
        "expansion",
        "general"
      ],
      "title": "ValidationLifecycleStage",
      "type": "string"
    },
    "ValidationStopCondition": {
      "enum": [
        "authentication_not_approved",
        "destructive_or_irreversible_action",
        "sensitive_data_boundary",
        "outside_approved_target",
        "rate_limit_or_anti_abuse",
        "policy_decision_required",
        "unrestricted_capture_required",
        "comparability_broken",
        "retention_safety_uncertain"
      ],
      "title": "ValidationStopCondition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "could_continue": {
      "title": "Could Continue",
      "type": "boolean"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9_]{2,63}$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ValidationFindingKind"
    },
    "lifecycle_stage": {
      "$ref": "#/$defs/ValidationLifecycleStage"
    },
    "observation": {
      "minLength": 1,
      "title": "Observation",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "stop_condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationStopCondition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "observed_at",
    "lifecycle_stage",
    "kind",
    "observation",
    "could_continue"
  ],
  "title": "ValidationFinding",
  "type": "object"
}
