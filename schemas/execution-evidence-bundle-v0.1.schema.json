{
  "$defs": {
    "ExecutionAction": {
      "enum": [
        "navigate",
        "fill",
        "click",
        "select",
        "read",
        "assert",
        "setup",
        "other"
      ],
      "title": "ExecutionAction",
      "type": "string"
    },
    "ExecutionEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "captured_stderr_persisted": {
          "const": false,
          "default": false,
          "title": "Captured Stderr Persisted",
          "type": "boolean"
        },
        "captured_stdout_persisted": {
          "const": false,
          "default": false,
          "title": "Captured Stdout Persisted",
          "type": "boolean"
        },
        "cartographer_runtime_required": {
          "const": false,
          "default": false,
          "title": "Cartographer Runtime Required",
          "type": "boolean"
        },
        "credentials_persisted": {
          "const": false,
          "default": false,
          "title": "Credentials Persisted",
          "type": "boolean"
        },
        "duration_seconds": {
          "minimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "environment": {
          "$ref": "#/$defs/RuntimeEnvironment"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "framework_execution_independent": {
          "const": true,
          "default": true,
          "title": "Framework Execution Independent",
          "type": "boolean"
        },
        "html_persisted": {
          "const": false,
          "default": false,
          "title": "Html Persisted",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Id",
          "type": "string"
        },
        "input_values_persisted": {
          "const": false,
          "default": false,
          "title": "Input Values Persisted",
          "type": "boolean"
        },
        "live_llm_used": {
          "const": false,
          "default": false,
          "title": "Live Llm Used",
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "profile_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Profile Id",
          "type": "string"
        },
        "raw_exception_messages_persisted": {
          "const": false,
          "default": false,
          "title": "Raw Exception Messages Persisted",
          "type": "boolean"
        },
        "raw_page_persisted": {
          "const": false,
          "default": false,
          "title": "Raw Page Persisted",
          "type": "boolean"
        },
        "raw_tracebacks_persisted": {
          "const": false,
          "default": false,
          "title": "Raw Tracebacks Persisted",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "screenshots_persisted": {
          "const": false,
          "default": false,
          "title": "Screenshots Persisted",
          "type": "boolean"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "steps": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExecutionStep"
          },
          "maxItems": 32,
          "title": "Steps",
          "type": "array"
        },
        "test": {
          "$ref": "#/$defs/TestIdentity"
        },
        "traceability": {
          "$ref": "#/$defs/ExecutionTraceability"
        },
        "traces_persisted": {
          "const": false,
          "default": false,
          "title": "Traces Persisted",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "run_id",
        "profile_id",
        "captured_at",
        "outcome",
        "test",
        "traceability",
        "environment",
        "duration_seconds",
        "sensitivity"
      ],
      "title": "ExecutionEvidenceRecord",
      "type": "object"
    },
    "ExecutionOutcome": {
      "enum": [
        "passed",
        "test_failure",
        "infrastructure_error"
      ],
      "title": "ExecutionOutcome",
      "type": "string"
    },
    "ExecutionPhase": {
      "enum": [
        "collection",
        "setup",
        "call",
        "teardown"
      ],
      "title": "ExecutionPhase",
      "type": "string"
    },
    "ExecutionStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ExecutionAction"
        },
        "input_value_persisted": {
          "const": false,
          "default": false,
          "title": "Input Value Persisted",
          "type": "boolean"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SanitizedApplicationLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "locator_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator Id"
        },
        "method_arguments_persisted": {
          "const": false,
          "default": false,
          "title": "Method Arguments Persisted",
          "type": "boolean"
        },
        "method_name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{2,79}$",
          "title": "Method Name",
          "type": "string"
        },
        "page_object": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{2,79}$",
          "title": "Page Object",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "step_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Step Id",
          "type": "string"
        },
        "target_element_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Element Id"
        }
      },
      "required": [
        "sequence",
        "step_id",
        "page_object",
        "method_name",
        "action"
      ],
      "title": "ExecutionStep",
      "type": "object"
    },
    "ExecutionTraceability": {
      "additionalProperties": false,
      "properties": {
        "adaptation_plan_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptation Plan Id"
        },
        "code_patch_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Patch Id"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "context_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Id"
        },
        "missing_fields": {
          "default": [],
          "items": {
            "enum": [
              "context_id",
              "process_id",
              "synthesis_run_id",
              "adaptation_plan_id",
              "code_patch_id"
            ],
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "process_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Id"
        },
        "source_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "synthesis_run_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthesis Run Id"
        }
      },
      "required": [
        "complete"
      ],
      "title": "ExecutionTraceability",
      "type": "object"
    },
    "FailureLocation": {
      "additionalProperties": false,
      "properties": {
        "function_name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{2,79}$",
          "title": "Function Name",
          "type": "string"
        },
        "line_number": {
          "minimum": 1,
          "title": "Line Number",
          "type": "integer"
        },
        "relative_path": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "line_number",
        "function_name"
      ],
      "title": "FailureLocation",
      "type": "object"
    },
    "FailureSummary": {
      "additionalProperties": false,
      "properties": {
        "captured_output_persisted": {
          "const": false,
          "default": false,
          "title": "Captured Output Persisted",
          "type": "boolean"
        },
        "exception_type": {
          "minLength": 1,
          "title": "Exception Type",
          "type": "string"
        },
        "expected_actual_values_persisted": {
          "const": false,
          "default": false,
          "title": "Expected Actual Values Persisted",
          "type": "boolean"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Message Sha256",
          "type": "string"
        },
        "message_truncated": {
          "title": "Message Truncated",
          "type": "boolean"
        },
        "phase": {
          "$ref": "#/$defs/ExecutionPhase"
        },
        "raw_message_persisted": {
          "const": false,
          "default": false,
          "title": "Raw Message Persisted",
          "type": "boolean"
        },
        "raw_traceback_persisted": {
          "const": false,
          "default": false,
          "title": "Raw Traceback Persisted",
          "type": "boolean"
        },
        "redaction_count": {
          "minimum": 0,
          "title": "Redaction Count",
          "type": "integer"
        },
        "safe_summary": {
          "minLength": 1,
          "title": "Safe Summary",
          "type": "string"
        },
        "traceback_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Traceback Sha256",
          "type": "string"
        }
      },
      "required": [
        "phase",
        "exception_type",
        "safe_summary",
        "message_sha256",
        "traceback_sha256",
        "redaction_count",
        "message_truncated"
      ],
      "title": "FailureSummary",
      "type": "object"
    },
    "RuntimeEnvironment": {
      "additionalProperties": false,
      "properties": {
        "environment_label": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Environment Label",
          "type": "string"
        },
        "environment_values_persisted": {
          "const": false,
          "default": false,
          "title": "Environment Values Persisted",
          "type": "boolean"
        },
        "framework_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Framework Id",
          "type": "string"
        },
        "host_name_persisted": {
          "const": false,
          "default": false,
          "title": "Host Name Persisted",
          "type": "boolean"
        },
        "platform_system": {
          "minLength": 1,
          "title": "Platform System",
          "type": "string"
        },
        "playwright_version": {
          "anyOf": [
            {
              "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Playwright Version"
        },
        "pytest_version": {
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
          "title": "Pytest Version",
          "type": "string"
        },
        "python_version": {
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$",
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "framework_id",
        "environment_label",
        "python_version",
        "pytest_version",
        "platform_system"
      ],
      "title": "RuntimeEnvironment",
      "type": "object"
    },
    "SanitizedApplicationLocation": {
      "additionalProperties": false,
      "properties": {
        "credentials_persisted": {
          "const": false,
          "default": false,
          "title": "Credentials Persisted",
          "type": "boolean"
        },
        "fragment_persisted": {
          "const": false,
          "default": false,
          "title": "Fragment Persisted",
          "type": "boolean"
        },
        "origin": {
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "query_persisted": {
          "const": false,
          "default": false,
          "title": "Query Persisted",
          "type": "boolean"
        }
      },
      "required": [
        "origin",
        "path"
      ],
      "title": "SanitizedApplicationLocation",
      "type": "object"
    },
    "TestIdentity": {
      "additionalProperties": false,
      "properties": {
        "line_number": {
          "minimum": 1,
          "title": "Line Number",
          "type": "integer"
        },
        "marker_names": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{2,79}$",
            "type": "string"
          },
          "title": "Marker Names",
          "type": "array"
        },
        "nodeid": {
          "minLength": 1,
          "title": "Nodeid",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "title": "Relative Path",
          "type": "string"
        },
        "test_name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{2,79}$",
          "title": "Test Name",
          "type": "string"
        }
      },
      "required": [
        "nodeid",
        "relative_path",
        "test_name",
        "line_number"
      ],
      "title": "TestIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cartographer_runtime_required": {
      "const": false,
      "default": false,
      "title": "Cartographer Runtime Required",
      "type": "boolean"
    },
    "collector_name": {
      "const": "test_cartographer_pytest_reference",
      "default": "test_cartographer_pytest_reference",
      "title": "Collector Name",
      "type": "string"
    },
    "collector_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Collector Version",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "framework_execution_independent": {
      "const": true,
      "default": true,
      "title": "Framework Execution Independent",
      "type": "boolean"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Id",
      "type": "string"
    },
    "infrastructure_error_count": {
      "minimum": 0,
      "title": "Infrastructure Error Count",
      "type": "integer"
    },
    "live_llm_used": {
      "const": false,
      "default": false,
      "title": "Live Llm Used",
      "type": "boolean"
    },
    "passed_count": {
      "minimum": 0,
      "title": "Passed Count",
      "type": "integer"
    },
    "profile_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Profile Id",
      "type": "string"
    },
    "raw_artifacts_persisted": {
      "const": false,
      "default": false,
      "title": "Raw Artifacts Persisted",
      "type": "boolean"
    },
    "records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExecutionEvidenceRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "test_failure_count": {
      "minimum": 0,
      "title": "Test Failure Count",
      "type": "integer"
    },
    "truncated_record_count": {
      "default": 0,
      "minimum": 0,
      "title": "Truncated Record Count",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "run_id",
    "profile_id",
    "started_at",
    "completed_at",
    "passed_count",
    "test_failure_count",
    "infrastructure_error_count"
  ],
  "title": "ExecutionEvidenceBundle",
  "type": "object"
}
